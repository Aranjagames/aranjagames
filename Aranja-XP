  async function nav(value,push=true){
    controller?.abort();controller=new AbortController();const signal=controller.signal;
    const timeout=setTimeout(()=>controller?.signal===signal&&controller.abort(),15000);
    const url=resolveBrowserURL(value);
    if(push){history=history.slice(0,index+1);history.push(url);index++}
    input.value=url;$('[data-back]',bar).disabled=index<=0;$('[data-forward]',bar).disabled=index>=history.length-1;
    w.body.onclick=null;w.status.textContent='Loading…';
    try{
      if(url==='aranja:home'){
        w.body.innerHTML='<div class="browser-home"><div class="brand">'+icon('aranja')+'<div><h1>Aranja Search</h1><span>Explore without leaving your desktop</span></div></div><p class="intro">Search Wikipedia and read articles right here in Aranja XP.<br>This is an encyclopedia search, not a whole-web search engine.</p>'+searchForm()+'<h3>Explore a topic</h3><div class="portal-grid">'+['Football','Video game','Solar System','Music'].map(q=>'<button class="portal-card" data-topic="'+q+'">'+icon('browser')+'<strong>'+q+'</strong></button>').join('')+'</div><h3>My favorites</h3>'+favorites.map((f,i)=>'<button class="classic" data-bookmark="'+i+'" style="margin:0 6px 6px 0">'+esc(f.label)+'</button>').join('')+'<p class="intro">You can also enter a website address. Sites that permit embedded browsing display in this window. Google addresses with a search query use the integrated Wikipedia search.</p></div>';
        bindSearch();w.body.onclick=e=>{const b=e.target.closest('button');if(b?.dataset.topic)nav(route('search',{q:b.dataset.topic,lang:read('searchLanguage','en')}));if(b?.dataset.bookmark!==undefined)nav(favorites[Number(b.dataset.bookmark)].url)};
        w.status.textContent='Home · Wikipedia search · Inside Aranja XP';
      }else if(url.startsWith('aranja:search?')||url.startsWith('aranja:article?')){
        const params=new URLSearchParams(url.split('?')[1]),lang=params.get('lang')==='es'?'es':'en';
        w.body.innerHTML='<div class="browser-home"><h1>Aranja Search</h1><p role="status">Loading Wikipedia…</p></div>';
        if(url.startsWith('aranja:search?')){
          const q=params.get('q')||'',offset=Math.max(0,Number(params.get('offset'))||0);
          const data=await api({list:'search',srsearch:q,srlimit:'10',sroffset:String(offset)},lang,signal);if(signal.aborted)return;
          const results=data.query?.search||[];
          w.body.innerHTML='<div class="browser-home"><h1>Aranja Search</h1>'+searchForm(q,lang)+'<p class="intro">Wikipedia results for “'+esc(q)+'” · Read any result inside Aranja XP.</p>'+results.map((r,i)=>'<button data-result="'+i+'" style="display:block;width:100%;text-align:left;background:white;border:0;border-bottom:1px solid #dae3ee;padding:15px 0"><strong style="color:#245ca1;font-size:17px">'+esc(r.title)+'</strong><p style="color:#46576b;line-height:1.6;margin-bottom:0">'+esc((r.snippet||'').replace(/<[^>]*>/g,''))+'</p></button>').join('')+(!results.length?'<p>No results found. Try another topic or language.</p>':'')+'<div style="margin-top:18px">'+(offset?'<button class="classic" data-page="previous">← Previous results</button> ':'')+(data.continue?'<button class="classic" data-page="next">More results →</button>':'')+'</div></div>';
          bindSearch();w.body.onclick=e=>{const b=e.target.closest('button');if(b?.dataset.result!==undefined)nav(route('article',{title:results[Number(b.dataset.result)].title,lang}));if(b?.dataset.page)nav(route('search',{q,lang,offset:b.dataset.page==='next'?data.continue.sroffset:Math.max(0,offset-10)}))};
          w.status.textContent=results.length+' results · Wikipedia · '+(lang==='es'?'Spanish':'English');
        }else{
          const data=await api({prop:'extracts',explaintext:'1',redirects:'1',titles:params.get('title')||''},lang,signal);if(signal.aborted)return;
          const page=data.query?.pages?.[0];if(!page||page.missing)throw new Error('Article not found');
          const source='https://'+lang+'.wikipedia.org/wiki/'+encodeURIComponent(page.title.replace(/ /g,'_'));
          w.body.innerHTML='<article class="browser-home"><div class="brand">'+icon('browser')+'<div><h1>'+esc(page.title)+'</h1><p>Wikipedia · Integrated reader</p></div></div><div style="white-space:pre-wrap;line-height:1.85;font-size:14px;margin-top:24px">'+esc(page.extract||'No readable text is available for this article.')+'</div><hr><p style="color:#657a93;line-height:1.6">Source: Wikipedia contributors · Article text is provided under CC BY-SA 4.0; additional terms may apply. Plain-text reading view.</p><p style="overflow-wrap:anywhere">'+esc(source)+'</p><button class="classic" data-source>View source and contributors in this window</button></article>';
          $('[data-source]',w.body).onclick=()=>nav(source+'?action=history');
          w.status.textContent=page.title+' · Wikipedia · CC BY-SA 4.0';
        }
      }else{
        w.body.innerHTML='<div style="height:100%;display:flex;flex-direction:column"><div class="hint">This website is displayed inside Aranja XP. If it blocks embedded viewing, use Home to search Wikipedia instead.</div><iframe title="Web page" style="width:100%;flex:1;border:0;background:white" sandbox="allow-scripts allow-forms allow-same-origin" referrerpolicy="no-referrer"></iframe></div>';
        $('iframe',w.body).src=url;w.status.textContent='Embedded website · Inside Aranja XP';
      }
    }catch(error){
      if(controller.signal!==signal)return;
      w.body.innerHTML='<div class="browser-home"><h1>Unable to load this page</h1><p>Check your Internet connection and try again. Wikipedia may be temporarily unavailable.</p><button class="classic" data-retry>Try again</button></div>';
      $('[data-retry]',w.body).onclick=()=>nav(url,false);w.status.textContent='Connection unavailable';
    }finally{clearTimeout(timeout)}
  }
  $('button',addr).onclick=()=>nav(input.value);input.onkeydown=e=>{if(e.key==='Enter')nav(input.value)};
  bar.onclick=e=>{const b=e.target.closest('button');if(!b)return;if(b.hasAttribute('data-back')&&index>0)nav(history[--index],false);if(b.hasAttribute('data-forward')&&index<history.length-1)nav(history[++index],false);if(b.hasAttribute('data-home'))nav('aranja:home');if(b.hasAttribute('data-reload'))nav(history[index],false);if(b.hasAttribute('data-fav')){const url=history[index];if(url==='aranja:home')return;const p=new URLSearchParams(url.split('?')[1]);if(!favorites.some(f=>f.url===url)){favorites.push({url,label:p.get('title')||p.get('q')||new URL(url).hostname});save('favorites',favorites)}notify('Favorite saved.')}};
  nav(initial);
}

function calculator(){let w=makeWindow('Calculator','calc',310,360),a=null,op=null,fresh=true;w.body.innerHTML='<div class="calc"><input class="calc-display" aria-label="Result" readonly value="0"><div class="calc-grid">'+['CE','C','⌫','÷','7','8','9','×','4','5','6','−','1','2','3','+','±','0','.','='].map(v=>'<button class="classic '+('÷×−+=C'.includes(v)?'op':'')+'">'+v+'</button>').join('')+'</div></div>';let d=$('input',w.body);function press(v){if(/^[0-9.]$/.test(v)){if(fresh){d.value=v==='.'?'0.':v;fresh=false}else if(v!=='.'||!d.value.includes('.')){d.value=d.value==='0'&&v!=='.'?v:d.value+v}return}if(v==='C'){a=op=null;d.value='0';fresh=true;return}if(v==='CE'){d.value='0';fresh=true;return}if(v==='⌫'){d.value=d.value.slice(0,-1)||'0';return}if(v==='±'){d.value=String(-Number(d.value));return}const n=Number(d.value);if(a!==null&&op&&!fresh){let r=op==='+'?a+n:op==='−'?a-n:op==='×'?a*n:n===0?NaN:a/n;d.value=Number.isFinite(r)?String(Number(r.toPrecision(12))):'Error';a=Number.isFinite(r)?r:null}else a=n;op=v==='='?null:v;fresh=true}$('.calc-grid',w.body).onclick=e=>{if(e.target.tagName==='BUTTON')press(e.target.textContent)};w.el.tabIndex=-1;w.el.onkeydown=e=>{let v=({'Enter':'=','Escape':'C','Backspace':'⌫','*':'×','/':'÷','-':'−',',':'.'}[e.key]||e.key);if(/^[0-9.+÷×−=]$/.test(v)||['C','⌫'].includes(v)){e.preventDefault();press(v)}};w.el.focus();w.status.textContent='Standard calculator'}
function paintApp(){let w=makeWindow('Untitled — Paint','paint',780,550);w.body.innerHTML='<div class="paint-wrap"><div class="paint-tools"><label>Color <input type="color" value="#193fbd" aria-label="Brush color"></label><label>Size <select aria-label="Brush size"><option>2</option><option selected>5</option><option>10</option><option>20</option></select></label><button class="classic" data-eraser>Eraser</button><button class="classic" data-clear>New</button><button class="classic" data-save>Save PNG</button></div><div class="canvas-wrap"><canvas width="900" height="550" aria-label="Drawing canvas"></canvas></div></div>';let c=$('canvas',w.body),ctx=c.getContext('2d'),drawing=false,eraser=false;ctx.fillStyle='white';ctx.fillRect(0,0,c.width,c.height);const point=e=>{let r=c.getBoundingClientRect();return [(e.clientX-r.left)*c.width/r.width,(e.clientY-r.top)*c.height/r.height]};c.onpointerdown=e=>{drawing=true;c.setPointerCapture(e.pointerId);ctx.strokeStyle=eraser?'#ffffff':$('input',w.body).value;ctx.lineWidth=Number($('select',w.body).value)*(eraser?4:1);ctx.lineCap='round';ctx.lineJoin='round';ctx.beginPath();let [x,y]=point(e);ctx.moveTo(x,y);ctx.lineTo(x+.01,y+.01);ctx.stroke()};c.onpointermove=e=>{if(drawing){ctx.lineTo(...point(e));ctx.stroke()}};c.onpointerup=c.onpointercancel=()=>drawing=false;$('[data-eraser]',w.body).onclick=e=>{eraser=!eraser;e.target.textContent=eraser?'Brush':'Eraser'};$('[data-clear]',w.body).onclick=()=>confirmDialog('New drawing','Clear the current drawing? Save the PNG first if you want to keep it.',()=>{ctx.fillStyle='white';ctx.fillRect(0,0,c.width,c.height)});$('[data-save]',w.body).onclick=()=>{let a=document.createElement('a');a.download='Aranja-Drawing.png';a.href=c.toDataURL();a.click()};w.status.textContent='Draw with your mouse or finger · Save your drawing before closing'}
function wallpaper(value){$('#wallpaper svg').style.display=value==='pradera'?'block':'none';$('#wallpaper').style.background=value==='azul'?'#3a6ea5':value==='noche'?'linear-gradient(#122743,#344f78)':value==='verde'?'#397b67':'';save('wallpaper',value)}wallpaper(read('wallpaper','pradera'));
function settingsApp(){let w=makeWindow('Control Panel — Display and sounds','settings',560,425);w.body.innerHTML='<div class="settings"><h3>Customize your Aranja XP</h3><div class="setting-row"><span>Desktop background</span><div class="wall-options"><button class="swatch" data-wall="pradera" title="Meadow" style="background:linear-gradient(#6db7f0 50%,#70a83b 50%)"></button><button class="swatch" data-wall="azul" title="Classic blue" style="background:#3a6ea5"></button><button class="swatch" data-wall="verde" title="Green" style="background:#397b67"></button><button class="swatch" data-wall="noche" title="Night" style="background:#122743"></button></div></div><label class="setting-row"><span>Click and typing sounds</span><input type="checkbox" '+(sound?'checked':'')+'></label><div class="setting-row"><span>Game shortcuts</span><button class="classic" data-games>Configure links</button></div><div class="setting-row"><span>Saved documents</span><button class="classic" data-export>Export JSON backup</button></div><p style="color:#666;line-height:1.6">Settings are saved in this browser. Use “Save as” in Notepad to download your text files.</p></div>';w.body.onclick=e=>{let b=e.target.closest('button');if(b?.dataset.wall)wallpaper(b.dataset.wall);if(b?.hasAttribute('data-games'))gamesConfig();if(b?.hasAttribute('data-export'))download('Aranja-documents.json',JSON.stringify({documents,deleted},null,2),'application/json')};$('input',w.body).onchange=e=>{sound=e.target.checked;save('sound',sound);soundUI()}}
function about(){let w=makeWindow('About Aranja XP','aranja',560,420);w.body.innerHTML='<div class="about"><div class="brand">'+icon('aranja')+'<div><h1 style="margin:0;color:#1f58a6">Aranja XP</h1><span>Your familiar desktop, your way.</span></div></div><p>An interactive desktop with a classic look: Start menu, taskbar, windows, documents, Recycle Bin, browser, Notepad, Paint, calculator and games.</p><p><strong>How to use it:</strong> double-click icons, drag the blue title bars to move windows, and drag the bottom-right corner to resize them. Right-click the desktop or a file for more options.</p><p>This is an HTML simulation with original graphics. It is not an installable operating system and cannot run desktop programs. Embedded browsing depends on each site’s restrictions.</p></div>'}
function contextMenu(e,items){let m=$('#context');m.innerHTML='';items.forEach(([label,fn])=>{let b=document.createElement('button');b.textContent=label;b.onclick=()=>{m.classList.add('hidden');fn()};m.append(b)});m.classList.remove('hidden');m.style.left=Math.min(e.clientX,innerWidth-m.offsetWidth-5)+'px';m.style.top=Math.min(e.clientY,innerHeight-m.offsetHeight-35)+'px'}
document.addEventListener('contextmenu',e=>{if(e.target.closest('.window,.taskbar,.start-menu'))return;e.preventDefault();contextMenu(e,[['Refresh',()=>{refreshFiles();notify('Desktop refreshed.')}],['New document',()=>notepad()],['Change background',settingsApp],['Games',gamesConfig],['About Aranja XP',about]])});
function runDialog(){inputDialog('Run: notepad, paint, calc, explorer or a URL','',v=>{let commands={notepad:'note',paint:'paint',calc:'calc',explorer:'files',control:'settings',browser:'browser'};if(commands[v.toLowerCase().trim()])launch(commands[v.toLowerCase().trim()]);else{let u=validURL(v);if(u&&v.includes('.'))browserApp(u);else notify('Unknown command. Use notepad, paint, calc, explorer, control or browser.')}})}
function lock(){let o=document.createElement('div');o.className='offscreen';o.innerHTML=icon('aranja')+'<h1>Aranja XP</h1><p>Session visually locked</p><button class="classic">Sign in as Aranja User</button><small>This screen does not password-protect your session.</small>';o.querySelector('button').onclick=()=>o.remove();document.body.append(o)}
function power(){let o=document.createElement('div');o.className='overlay';o.innerHTML='<section class="shutdown-panel"><h2>Turn off Aranja XP</h2><div class="shutdown-actions"><button data-action="lock"><span class="power-icon" style="background:#d9a02c">Ⅱ</span>Stand by</button><button data-action="off"><span class="power-icon" style="background:#d95635">⏻</span>Turn off</button><button data-action="restart"><span class="power-icon" style="background:#56a144">↻</span>Restart</button></div><footer><button class="classic" data-action="cancel">Cancel</button></footer></section>';o.onclick=e=>{let a=e.target.closest('[data-action]')?.dataset.action;if(!a)return;o.remove();if(a==='lock')lock();if(a==='restart'){wins.forEach(w=>w.cleanup?.());location.reload()}if(a==='off'){[...wins.keys()].forEach(closeWin);let s=document.createElement('div');s.className='offscreen';s.innerHTML=icon('aranja')+'<h1>Aranja XP</h1><p>You can now close this tab.</p><button class="classic">Power on</button>';s.querySelector('button').onclick=()=>s.remove();document.body.append(s)}};document.body.append(o)}
window.addEventListener('beforeunload',()=>wins.forEach(w=>w.cleanup?.()));
window.addEventListener('resize',()=>{wins.forEach(w=>{if(w.max)return;let r=w.el.getBoundingClientRect();w.el.style.left=Math.max(0,Math.min(r.left,innerWidth-100))+'px';w.el.style.top=Math.max(0,Math.min(r.top,innerHeight-61))+'px'})});
const fullscreenNotice=$('#fullscreenNotice');
function closeFullscreenNotice(){fullscreenNotice.classList.add('hidden')}
$('.fullscreen-notice-close',fullscreenNotice).onclick=closeFullscreenNotice;
$('[data-dismiss-fullscreen]',fullscreenNotice).onclick=closeFullscreenNotice;
$('#boot').innerHTML=icon('aranja')+'<div><h1>Aranja <strong>XP</strong></h1><p>Preparing your desktop…</p><div class="bootbar"></div></div>';setTimeout(()=>{$('#boot').style.opacity=0;setTimeout(()=>{$('#boot').remove();fullscreenNotice.classList.remove('hidden');$('[data-dismiss-fullscreen]',fullscreenNotice).focus()},450)},1000);
